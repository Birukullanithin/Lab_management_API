  "components": {
    "schemas": {
      "LegalEntityDto": {
        "required": [
          "legalEntityName"
        ],
        "type": "object",
        "properties": {
          "legalEntityId": {
            "type": "integer",
            "format": "int32"
          },
          "organizationId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "legalEntityCode": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "legalEntityName": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "legalEntityAddress": {
            "type": "string",
            "nullable": true
          },
          "gstNumber": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "contactNumber": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "email": {
            "maxLength": 100,
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "organizationId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "legalEntityId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "patientId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "orderNumber": {
            "type": "string",
            "nullable": true
          },
          "orderDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "totalAmount": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "remarks": {
            "type": "string",
            "nullable": true
          },
          "orderNames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestMasterDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrganizationDto": {
        "required": [
          "organizationName"
        ],
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "integer",
            "format": "int32"
          },
