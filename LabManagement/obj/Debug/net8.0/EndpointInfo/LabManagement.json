  "components": {
    "schemas": {
      "OrderDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "patientId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "orderNumber": {
            "type": "string",
            "nullable": true
          },
          "orderDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "totalAmount": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "remarks": {
            "type": "string",
            "nullable": true
          },
          "orderNames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestMasterDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PatientDto": {
        "required": [
          "patientName"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "organizationId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "legalEntityId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "patientName": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "gender": {
            "maxLength": 10,
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "phone": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "email": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "testNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "order": {
            "$ref": "#/components/schemas/OrderDto"
          }
        },
        "additionalProperties": false
      },
      "TestMasterDto": {
        "type": "object",
        "properties": {
          "testId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "testName": {
            "type": "string",
            "nullable": true
          },
          "testCode": {
            "type": "string",
            "nullable": true
          },
          "normalMin": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "normalMax": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}